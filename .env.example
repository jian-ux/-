# Set to reranker on NVIDIA Docker hosts to include the GPU service in normal
# docker compose up commands. Leave empty on CPU-only deployments.
COMPOSE_PROFILES=

MYSQL_PASSWORD=replace-with-your-mysql-password
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_HOST_PORT=6380
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=feisheng-docs

DINGTALK_APP_SECRET=
DINGTALK_TOKEN=
DINGTALK_ENCODING_AES_KEY=
DINGTALK_STREAM_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_STREAM_CONSUME_THREADS=4
DINGTALK_STREAM_PROCESSING_WORKER_THREADS=4
DINGTALK_STREAM_PROCESSING_QUEUE_CAPACITY=100
DINGTALK_MEDIA_WORKER_THREADS=2
DINGTALK_MEDIA_QUEUE_CAPACITY=50
DINGTALK_MEDIA_CONNECT_TIMEOUT_MS=10000
DINGTALK_MEDIA_READ_TIMEOUT_MS=30000
DINGTALK_MEDIA_MAX_IMAGE_BYTES=10485760
DINGTALK_MEDIA_MAX_AUDIO_BYTES=26214400
DINGTALK_MEDIA_MAX_TEXT_CHARS=8000
DINGTALK_MEDIA_FFMPEG_COMMAND=ffmpeg
DINGTALK_MEDIA_FFMPEG_TIMEOUT_SECONDS=60

WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
WECOM_API_BASE=https://qyapi.weixin.qq.com

# RAG phase 2 quality policy
RAG_TOP_K=3
RAG_CONTEXT_MAX_HISTORY_MESSAGES=6
RAG_CONTEXT_MAX_RETRIEVAL_HISTORY_MESSAGES=4
RAG_CONTEXT_MAX_RETRIEVAL_HISTORY_CHARS=1200
RAG_CONTEXT_MAX_PROMPT_TOKENS=4000
RAG_CANDIDATE_K=10
RAG_DIRECT_THRESHOLD=0.82
RAG_CONTEXT_THRESHOLD=0.50
RAG_LEXICAL_THRESHOLD=0.72
RAG_BM25_ENABLED=true
RAG_BM25_MIN_SCORE=0.0
RAG_BM25_FALLBACK_MIN_SCORE=8.0
RAG_BM25_FALLBACK_MIN_GAP_RATIO=1.10
RAG_BM25_FALLBACK_MIN_QUESTION_SIMILARITY=0.60
RAG_BM25_FALLBACK_CONFIDENCE=0.65
RAG_RANK_FUSION_K=60
RAG_NEIGHBOR_RADIUS=1
RAG_MAX_NEIGHBOR_CHUNKS=4
RAG_QUERY_EXPANSION_ENABLED=false
RAG_QUERY_EXPANSION_MAX_VARIANTS=5
RAG_QUERY_EXPANSION_MAX_QUERY_CHARS=160
RAG_STRUCTURED_UNIT_INDEX_ENABLED=false
RAG_STRUCTURED_UNIT_INDEX_SHADOW_ONLY=true
RAG_STRUCTURED_UNIT_INDEX_TOP_K=5
RAG_STRUCTURED_UNIT_INDEX_WEIGHT=0.65
KNOWLEDGE_CHUNK_MAX_CHARS=600
KNOWLEDGE_CHUNK_MIN_CHARS=50
KNOWLEDGE_CHUNK_OVERLAP_CHARS=80
KNOWLEDGE_STRUCTURED_EXTRACTION_BATCH_SIZE=8
KNOWLEDGE_STRUCTURED_EXTRACTION_MAX_SOURCE_CHARS=8000
KNOWLEDGE_STRUCTURED_EXTRACTION_MAX_UNITS_PER_BATCH=20
RAG_RERANK_ENABLED=false
# Compose Qwen service. Set COMPOSE_PROFILES=reranker when enabling it.
RAG_RERANK_URL=http://reranker:8091/rerank
RAG_RERANK_API_KEY=replace-with-a-random-local-reranker-key
RAG_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
RAG_RERANK_CONNECT_TIMEOUT_MS=1000
RAG_RERANK_READ_TIMEOUT_MS=15000
RAG_RERANK_MAX_CANDIDATES=10
RAG_RERANK_MAX_DOCUMENT_CHARS=2000
RAG_RERANK_HIGH_MIN_SCORE=0.65
RAG_RERANK_HIGH_MIN_GAP=0.08
RAG_RERANK_MEDIUM_MIN_SCORE=0.40
# Exact/structured candidates may stay pinned ahead of a slightly higher model score.
RAG_RERANK_MEDIUM_MIN_GAP=-0.10
RAG_STRUCTURED_QA_ENABLED=true
RAG_STRUCTURED_QA_EXACT_MIN_SCORE=0.82
RAG_STRUCTURED_QA_RERANK_MIN_SCORE=0.65
RAG_STRUCTURED_QA_RERANK_MIN_GAP=0.08
# Qwen3-VL-Reranker-2B container settings.
RERANK_API_KEY=replace-with-the-same-random-local-reranker-key
RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
RERANK_HOST_PORT=8091
RERANK_MAX_LENGTH=2048
RERANK_BATCH_SIZE=1
RERANK_CACHE_MAX_ENTRIES=256
# Optional Hugging Face token for faster first-time model downloads.
HF_TOKEN=
# Comma-separated terms that identify headquarters or other non-Dianqian business.
RAG_OUT_OF_SCOPE_KEYWORDS=CA锁,实体锁,UKey,U-Key,安全控件,守信签,总部电子签章,翔晟电子签章
RAG_NO_ANSWER_REPLY=这个问题我暂时无法准确确认。请补充具体的产品、功能或使用场景，我会继续为您核实。
RAG_UNRELATED_REPLY=这个问题不属于点签电子合同业务服务范围。您可以继续咨询点签产品、合同签署或使用操作相关问题。
RAG_ERROR_REPLY=当前查询出现异常，暂时无法完成回答，请稍后重试。
RAG_NO_ANSWER_TRANSFER=false
RAG_HANDOFF_LOW_CONFIDENCE_THRESHOLD=0.55
RAG_HANDOFF_PRICE_KEYWORDS=定制报价,专属报价,商务报价,最终报价,折扣,优惠,议价,最低价,底价,便宜点,打折
RAG_HANDOFF_PRICE_REPLY=
RAG_HANDOFF_PRICE_FAILED_REPLY=
RAG_INDEX_SYNC_INTERVAL_MS=30000
RAG_REQUIRE_CONSISTENT_EMBEDDING_VERSION=false
RAG_MULTIMODAL_CONTEXT_MAX_CHARS=4000
# Controlled LLM fallback for questions that have no reliable knowledge-base match.
RAG_NATIVE_FALLBACK_ENABLED=false
RAG_NATIVE_FALLBACK_HIGH_RISK_KEYWORDS=合同条款,法律效力,违约责任,赔偿责任,合规承诺,保证结果,隐私泄露,个人信息泄露
RAG_NATIVE_FALLBACK_CLARIFICATION_KEYWORDS=这个,那个,它,这款,那款,然后呢
RAG_NATIVE_FALLBACK_HIGH_RISK_TRANSFER=true
RAG_NATIVE_FALLBACK_CLARIFICATION_REPLY=
RAG_NATIVE_FALLBACK_HIGH_RISK_REPLY=
# Leave empty to use the built-in restricted native-answer prompt.
AI_NATIVE_FALLBACK_SYSTEM_PROMPT=
# V2 is the accepted production customer-service prompt.
AI_CUSTOMER_SERVICE_PROMPT_VERSION=v2
# Optional full prompt overrides. Mandatory product, legal, privacy, and tool boundaries
# are appended by the application and cannot be removed by these values.
AI_CUSTOMER_SERVICE_SYSTEM_PROMPT_V1=
AI_CUSTOMER_SERVICE_SYSTEM_PROMPT_V2=
# Legacy V1 override retained for rolling upgrades. Prefer SYSTEM_PROMPT_V1.
AI_CUSTOMER_SERVICE_SYSTEM_PROMPT_FULL=
AI_EMBEDDING_CONNECT_TIMEOUT_MS=10000
AI_EMBEDDING_READ_TIMEOUT_MS=30000
AI_EMBEDDING_BATCH_SIZE=32
AI_EMBEDDING_MAX_ATTEMPTS=3
AI_EMBEDDING_RETRY_DELAY_MS=1000
AI_LLM_CONNECT_TIMEOUT_MS=10000
AI_LLM_READ_TIMEOUT_MS=60000
AI_LLM_MAX_RETRIES=1
KNOWLEDGE_STRUCTURED_EXTRACTION_MODEL_READ_TIMEOUT_MS=240000
KNOWLEDGE_STRUCTURED_EXTRACTION_MODEL_MAX_RETRIES=0

# Public HTTPS origin used by DingTalk to load signed knowledge images.
# Example: https://bot.example.com (leave empty for local web-only testing).
APP_PUBLIC_BASE_URL=
KNOWLEDGE_IMAGE_URL_TTL_SECONDS=3600
KNOWLEDGE_IMAGE_MAX_BYTES=10485760
KNOWLEDGE_IMAGE_MAX_PER_REPLY=3

# Comma-separated official values that must not be redacted in replies
SECURITY_PII_ALLOWED_VALUES=18689633999

# Read-only order and logistics business API. Disabled uses the local demo data source.
BUSINESS_API_ENABLED=false
BUSINESS_DISPLAY_ZONE=Asia/Shanghai
BUSINESS_API_BASE_URL=
BUSINESS_API_TOKEN=
BUSINESS_API_ORDER_PATH=/orders/{orderNo}
BUSINESS_API_LOGISTICS_PATH=/logistics/{orderNo}
BUSINESS_API_CONNECT_TIMEOUT_SECONDS=3
BUSINESS_API_READ_TIMEOUT_SECONDS=8
BUSINESS_API_REQUIRE_OWNER_MATCH=true

# Phase 5 Qdrant vector store
QDRANT_ENABLED=true
QDRANT_HOST_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=feisheng_knowledge
QDRANT_SEMANTIC_UNIT_COLLECTION=feisheng_knowledge_semantic_units
QDRANT_VECTOR_SIZE=2048
QDRANT_BATCH_SIZE=64
QDRANT_CONNECT_TIMEOUT_SECONDS=2
QDRANT_READ_TIMEOUT_SECONDS=10

# Phase 3 image OCR
OCR_TESSERACT_COMMAND=tesseract
OCR_LANGUAGES=chi_sim+eng
OCR_TIMEOUT_SECONDS=60
OCR_IMAGE_MAX_BYTES=10485760
OCR_IMAGE_MAX_PIXELS=40000000
OCR_IMAGE_MAX_DIMENSION=3200
OCR_CHAT_RETENTION_HOURS=24

# Phase 4 speech-to-text (OpenAI-compatible transcription API)
# Zhipu example: SPEECH_API_URL=https://open.bigmodel.cn/api/paas/v4/audio/transcriptions
# Zhipu example: SPEECH_MODEL=glm-asr-2512 (audio duration <= 30 seconds)
SPEECH_ENABLED=false
SPEECH_API_URL=https://api.openai.com/v1/audio/transcriptions
SPEECH_API_KEY=
SPEECH_MODEL=whisper-1
SPEECH_LANGUAGE=zh
SPEECH_PROMPT=
SPEECH_MAX_BYTES=26214400
SPEECH_CONNECT_TIMEOUT_SECONDS=10
SPEECH_TIMEOUT_SECONDS=120

# Phase 6 text-to-speech (OpenAI-compatible speech API)
TTS_ENABLED=false
TTS_API_URL=https://api.openai.com/v1/audio/speech
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3
TTS_SPEED=1.0
TTS_MAX_INPUT_CHARS=2000
TTS_MAX_BYTES=10485760
TTS_CONNECT_TIMEOUT_SECONDS=10
TTS_TIMEOUT_SECONDS=120
