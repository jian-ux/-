# Stage 1: Build frontend
FROM node:20-alpine AS build
WORKDIR /app
COPY feisheng-bot-admin-ui/package*.json ./
RUN npm ci
COPY feisheng-bot-admin-ui/ ./
RUN npm run build

# Stage 2: Nginx serve
FROM nginx:alpine
COPY docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1/api/health | grep -q '"status":"UP"' || exit 1
