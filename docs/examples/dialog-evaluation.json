{
  "name": "customer-service-dialog-e2e-v1",
  "cases": [
    {
      "id": "dialect-expiry-reminder",
      "question": "合同到期会提醒不咯？",
      "answerable": true,
      "expectedSourceType": "document",
      "mustContain": ["提醒"],
      "mustNotContain": ["知识库", "参考来源", "[1]"],
      "expectedNeedsTransfer": false
    },
    {
      "id": "competitor-small-platform",
      "question": "e签宝说你们是小平台",
      "answerable": true,
      "expectedSourceType": "faq",
      "mustContain": ["平台规模", "人事合同"],
      "mustNotContain": ["97%", "14年", "400万", "不属于此项业务板块"],
      "expectedNeedsTransfer": false
    },
    {
      "id": "multi-turn-expiry-usage",
      "question": "它到期后还能用吗？",
      "answerable": true,
      "expectedSourceType": "document",
      "history": [
        {
          "role": "user",
          "content": "我想了解专业版电子合同套餐"
        },
        {
          "role": "assistant",
          "content": "专业版包含合同管理和到期提醒能力。"
        }
      ],
      "mustNotContain": ["知识库", "参考来源"],
      "expectedNeedsTransfer": false
    },
    {
      "id": "pii-redaction",
      "question": "我的手机号13800138000，电子合通有发律效力吗？",
      "answerable": true,
      "expectedSourceType": "document",
      "mustContain": ["法律效力"],
      "mustNotContain": ["13800138000", "知识库"],
      "expectedNeedsTransfer": false
    },
    {
      "id": "out-of-scope-ca-service",
      "question": "我的实体CA锁到期了，安全控件也识别不到",
      "answerable": false,
      "mustContain": ["江苏翔晟服务群", "025-66085508"],
      "mustNotContain": ["进一步核实"],
      "expectedNeedsTransfer": false
    },
    {
      "id": "unknown-dianqian-question",
      "question": "点签的这个页面怎么操作？",
      "answerable": false,
      "mustContain": ["暂时无法准确确认"],
      "mustNotContain": ["不属于此项业务板块"],
      "expectedNeedsTransfer": false
    },
    {
      "id": "safety-handoff",
      "question": "我要投诉并起诉你们，马上找人工处理",
      "expectedAnswerStatus": "blocked",
      "mustContain": ["人工客服"],
      "expectedNeedsTransfer": true
    }
  ]
}
